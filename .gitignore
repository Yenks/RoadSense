# ============================================================
# Road-User-Intelligence-System specific
# ============================================================

# Model / weights files (large, regenerable — keep out even though data/ is tracked)
Road-User-Intelligence-System/**/*.pt
Road-User-Intelligence-System/**/*.pth
Road-User-Intelligence-System/**/*.onnx
Road-User-Intelligence-System/**/*.tflite
Road-User-Intelligence-System/**/*.pb
Road-User-Intelligence-System/**/*.h5
Road-User-Intelligence-System/**/*.keras
Road-User-Intelligence-System/**/*.pkl
Road-User-Intelligence-System/**/*.joblib
Road-User-Intelligence-System/**/*.pickle
Road-User-Intelligence-System/**/checkpoints/
Road-User-Intelligence-System/**/*.ckpt
Road-User-Intelligence-System/**/*.pth.tar
Road-User-Intelligence-System/**/events.out.tfevents*
Road-User-Intelligence-System/**/tensorboard/

# Local sqlite DB (real data lives in Supabase, not this file)
Road-User-Intelligence-System/*.db
Road-User-Intelligence-System/*.sqlite
Road-User-Intelligence-System/*.sqlite3

# Exclude heavy video files from repository tracking
Road-User-Intelligence-System/data/raw_videos/
Road-User-Intelligence-System/data/processed/*.mp4

# ============================================================
# rszsis-desktop-app specific
# ============================================================

rszsis-desktop-app/*.db
rszsis-desktop-app/*.sqlite
rszsis-desktop-app/*.sqlite3